rules_version = '2';

// Mesada da Lili — cada conta da família só acessa families/{seu uid} e o que estiver dentro.
// Todo o resto é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // subcoleções: children, history, photos (e qualquer outra abaixo da família)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // qualquer outro caminho: negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
